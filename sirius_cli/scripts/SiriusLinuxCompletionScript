      return
      ;;
    --delete-by-name|--dn)
      return
      ;;
    --delete-by-mass|--dm)
      return
      ;;
    --keep-by-idx|--ki|-k)
      return
      ;;
    --keep-by-mass|--km)
      return
      ;;
    --keep-by-name|--kn)
