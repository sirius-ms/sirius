  local prev_word=${COMP_WORDS[COMP_CWORD-1]}

  local commands=""
  local flag_opts="--classyfire --npc --fingerprints --fingerprint --pubchem --maccs --all --compress --zip -c -h --help -V --version"
  local arg_opts="--digits --precision -p --output -o"

