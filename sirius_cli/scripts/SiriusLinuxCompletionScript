  if CompWordsContainsArray "${cmds9[@]}"; then _picocli_sirius_ftreeexport; return $?; fi
  if CompWordsContainsArray "${cmds8[@]}"; then _picocli_sirius_MGF; return $?; fi
  if CompWordsContainsArray "${cmds7[@]}"; then _picocli_sirius_mgfexport; return $?; fi
  if CompWordsContainsArray "${cmds6[@]}"; then _picocli_sirius_decomp; return $?; fi
