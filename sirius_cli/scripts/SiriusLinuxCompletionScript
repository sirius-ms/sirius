  local arg_opts="--library-hits --considered-candidates-at-300 --thresholdFilter --minLocalConnections --considered-candidates-at-800 --min-cosine --lambda --iterations --burn-in"

  type compopt &>/dev/null && compopt +o default

  case ${prev_word} in
    --library-hits)
      return
      ;;
    --considered-candidates-at-300)
      return
      ;;
    --thresholdFilter)
      return
      ;;
    --minLocalConnections)
      return
      ;;
    --considered-candidates-at-800)
      return
      ;;
    --min-cosine)
      return
      ;;
    --lambda)
      return
      ;;
    --iterations)
      return
      ;;
    --burn-in)
      return
      ;;
  esac

  if [[ "${curr_word}" == -* ]]; then
    COMPREPLY=( $(compgen -W "${flag_opts} ${arg_opts}" -- "${curr_word}") )
  else
    local positionals=""
    COMPREPLY=( $(compgen -W "${commands} ${positionals}" -- "${curr_word}") )
  fi
}

