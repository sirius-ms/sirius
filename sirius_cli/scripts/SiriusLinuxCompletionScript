# Generates completions for the options and subcommands of the `fingerprint` subcommand.
function _picocli_sirius_config_A_F_rerankformulas_P_fingerprint() {
  # Get completion data
  local curr_word=${COMP_WORDS[COMP_CWORD]}

  local commands="structure search-structure-db S canopus compound-classes C write-summaries W"
  local flag_opts="--no-threshold -h --help -V --version"
