# Generates completions for the options and subcommands of the `zodiac` subcommand. 
function _picocli_sirius_config_lcmsalign_F_zodiac() {
  # Get completion data
  local curr_word=${COMP_WORDS[COMP_CWORD]}
  local prev_word=${COMP_WORDS[COMP_CWORD-1]}

  local commands="passatutto P fingerprint T write-summaries W"
  local flag_opts="--ignore-spectra-quality -h --help -V --version"
  local arg_opts="--library-hits --considered-candidates-at-300 --considered-candidates-at-800 --min-cosine --lambda --iterations --burn-in --minLocalConnections --thresholdFilter"

  type compopt &>/dev/null && compopt +o default

  case ${prev_word} in
    --library-hits)
      return
      ;;
    --considered-candidates-at-300)
      return
      ;;
    --considered-candidates-at-800)
      return
      ;;
    --min-cosine)
      return
      ;;
    --lambda)
      return
      ;;
    --iterations)
      return
      ;;
    --burn-in)
      return
      ;;
    --minLocalConnections)
      return
      ;;
    --thresholdFilter)
      return
