    --merge-compounds-cosine) 
      return 
      ;; 
    --split|-s) 
      COMPREPLY=( $( compgen -W "${type_option_args}" -- "${curr_word}" ) ) 
      return $? 
      ;; 
    --count|-c) 
      return 
      ;; 
    --split-order|-o) 
      COMPREPLY=( $( compgen -W "${order_option_args}" -- "${curr_word}" ) ) 
      return $? 
      ;; 
    --keep-by-confidence|--kc) 
      return 
      ;; 
