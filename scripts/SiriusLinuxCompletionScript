  type compopt &>/dev/null && compopt +o default

  case ${prev_word} in
    -d|--database|--db)
      COMPREPLY=( $( compgen -W "${dbNamedbName_option_args}" -- "${curr_word}" ) )
      return $?
      ;;
    -l|flag-lipids|--elgordo)
      return
      ;;
  esac

