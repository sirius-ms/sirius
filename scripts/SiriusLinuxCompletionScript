  local arg_opts="--library-hits --considered-candidates-at-300 --considered-candidates-at-800 --min-cosine --lambda --iterations --burn-in --minLocalConnections --thresholdFilter"

  type compopt &>/dev/null && compopt +o default

  case ${prev_word} in
    --library-hits)
      return
      ;;
    --considered-candidates-at-300)
      return
      ;;
    --considered-candidates-at-800)
      return
      ;;
    --min-cosine)
      return
      ;;
    --lambda)
      return
      ;;
    --iterations)
      return
      ;;
    --burn-in)
      return
      ;;
    --minLocalConnections)
      return
      ;;
    --thresholdFilter)
      return
      ;;
  esac

  if [[ "${curr_word}" == -* ]]; then
    COMPREPLY=( $(compgen -W "${flag_opts} ${arg_opts}" -- "${curr_word}") )
