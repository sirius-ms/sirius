      return 
      ;; 
    --tree-timeout) 
      return 
      ;; 
    --compound-timeout) 
      return 
      ;; 
    -p|--profile) 
      return 
      ;; 
    -c|--candidates) 
      return 
      ;; 
    --candidates-per-ion) 
      return 
      ;; 
    -e|--elements-considered) 
      return 
      ;; 
    -E|--elements-enforced) 
      return 
      ;; 
    -f|--formulas) 
      return 
      ;; 
    -i|--ions-considered) 
      return 
      ;; 
    --heuristic-only) 
      return 
      ;; 
