    --ppm-max)
      return
      ;;
    --ppm-max-ms2)
      return
      ;;
    --tree-timeout)
      return
      ;;
    --compound-timeout)
      return
      ;;
    -p|--profile)
      return
      ;;
    -c|--candidates)
      return
      ;;
    --candidates-per-ion)
      return
      ;;
    -e|--elements-considered)
      return
      ;;
    -E|--elements-enforced)
      return
      ;;
    -f|--formulas)
      return
      ;;
    -i|--ions-considered)
      return
      ;;
    --heuristic-only)
      return
      ;;
  esac

  if [[ "${curr_word}" == -* ]]; then
    COMPREPLY=( $(compgen -W "${flag_opts} ${arg_opts}" -- "${curr_word}") )
  else
    local positionals=""
    COMPREPLY=( $(compgen -W "${commands} ${positionals}" -- "${curr_word}") )
  fi
}

