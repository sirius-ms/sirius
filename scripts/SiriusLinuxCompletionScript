      COMPREPLY=( $( compgen -W "${dbNamedbName_option_args}" -- "${curr_word}" ) )
      return $?
      ;;
    -l|flag-lipids|--elgordo)
      return
      ;;
  esac

  if [[ "${curr_word}" == -* ]]; then
    COMPREPLY=( $(compgen -W "${flag_opts} ${arg_opts}" -- "${curr_word}") )
  else
    local positionals=""
    COMPREPLY=( $(compgen -W "${commands} ${positionals}" -- "${curr_word}") )
  fi
}

