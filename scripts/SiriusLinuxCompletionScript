      return
      ;;
    -e|--elements-considered)
      return
      ;;
    -E|--elements-enforced)
      return
      ;;
    -f|--formulas)
      return
      ;;
    -i|--ions-considered)
      return
      ;;
    --heuristic-only)
      return
      ;;
  esac

  if [[ "${curr_word}" == -* ]]; then
