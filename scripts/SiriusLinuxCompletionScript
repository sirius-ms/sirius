# Generates completions for the options and subcommands of the `sirius` command. 
function _picocli_sirius() { 
  # Get completion data 
  local curr_word=${COMP_WORDS[COMP_CWORD]} 
  local prev_word=${COMP_WORDS[COMP_CWORD-1]} 
 
  local commands="config project-space custom-db similarity decomp mgf-export ftree-export prediction-export login generateAutocompletion write-summaries lcms-align zodiac canopus passatutto formula structure fingerprint "
  local flag_opts="--update-fingerprint-version --ignore-formula --allow-ms1-only --recompute --no-citations --noCitations --noCite -h --help -V --version" 
  local arg_opts="--maxmz --output --project -o --naming-convention --input -i -z --parentmass --precursor --mz --ionization --adduct -f --formula -1 --ms1 -2 --ms2 --compound-buffer --initial-compound-buffer --log --loglevel --cores --processors" 
  local logLevel_option_args="SEVERE WARNING INFO FINER ALL" # --loglevel values 
 
  type compopt &>/dev/null && compopt +o default 
 
  case ${prev_word} in 
    --maxmz) 
      return 
      ;; 
    --output|--project|-o) 
      local IFS=$'\n' 
      type compopt &>/dev/null && compopt -o filenames 
      COMPREPLY=( $( compgen -f -- "${curr_word}" ) ) # files 
      return $? 
      ;; 
    --naming-convention) 
      return 
      ;; 
    --input|-i) 
      local IFS=$'\n' 
      type compopt &>/dev/null && compopt -o filenames 
      COMPREPLY=( $( compgen -f -- "${curr_word}" ) ) # files 
      return $? 
      ;; 
    -z|--parentmass|--precursor|--mz) 
      return 
      ;; 
    --ionization|--adduct) 
      return 
      ;; 
    -f|--formula) 
      return 
      ;; 
    -1|--ms1) 
      return 
      ;; 
    -2|--ms2) 
      return 
      ;; 
    --compound-buffer|--initial-compound-buffer) 
      return 
      ;; 
    --log|--loglevel) 
      COMPREPLY=( $( compgen -W "${logLevel_option_args}" -- "${curr_word}" ) ) 
      return $? 
      ;; 
    --cores|--processors) 
      return 
      ;; 
  esac 
 
  if [[ "${curr_word}" == -* ]]; then 
    COMPREPLY=( $(compgen -W "${flag_opts} ${arg_opts}" -- "${curr_word}") ) 
  else 
    local positionals="" 
    COMPREPLY=( $(compgen -W "${commands} ${positionals}" -- "${curr_word}") ) 
  fi 
} 
 
