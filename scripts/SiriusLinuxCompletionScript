  local type_option_args="NO NUMBER SIZE" # --split values 
  local order_option_args="SHUFFLE MASS NAME" # --split-order values 
 
  type compopt &>/dev/null && compopt +o default 
 
  case ${prev_word} in 
    --merge-compounds-top) 
      return 
